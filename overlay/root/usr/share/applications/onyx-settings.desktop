[Desktop Entry]
Type=Application
Name=ONYX Settings
GenericName=System Settings
Comment=Configure ONYX desktop and hardware
Exec=/usr/bin/python3 /usr/share/onyx-os/shell.py settings
Icon=preferences-system
Terminal=false
Categories=Settings;
Keywords=wifi;display;theme;settings;
StartupWMClass=org.onyx.Desktop.Settings
