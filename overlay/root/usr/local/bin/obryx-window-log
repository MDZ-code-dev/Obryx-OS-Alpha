#!/usr/bin/env bash
# TEMPORARY alpha diagnostic (remove once the stray black window is fixed).
# The black box appears after login, a little later than the panels, so log
# every window KWin knows about every 4 seconds for about 100 seconds, plus
# the newest processes, to name the program that opens it.
log() { logger -t obryx-windows "$*"; }
log "diagnostic started"
script=$(mktemp --suffix=.js)
cat > "$script" <<'EOF'
const windows = workspace.windowList ? workspace.windowList() : workspace.clientList();
for (const w of windows) {
    const g = w.frameGeometry;
    print("OBRYX_WINDOW class=" + w.resourceClass + " name=" + w.resourceName
        + " caption=" + w.caption + " pid=" + w.pid + " at=" + g.x + "," + g.y
        + " size=" + g.width + "x" + g.height + " normal=" + w.normalWindow
        + " dialog=" + w.dialog + " desktop=" + w.desktopWindow + " dock=" + w.dock
        + " special=" + w.specialWindow + " x11=" + (w.windowId ? "yes" : "no")
        + " opacity=" + w.opacity);
}
EOF
for round in $(seq 1 25); do
  dbus-send --session --print-reply --dest=org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript string:obryx-window-log >/dev/null 2>&1
  reply=$(dbus-send --session --print-reply --dest=org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript string:"$script" string:obryx-window-log 2>&1)
  id=$(printf '%s\n' "$reply" | awk '/int32/ {print $2}')
  log "round $round script ${id:-none}"
  if [ -n "$id" ]; then
    dbus-send --session --print-reply --dest=org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script.run >/dev/null 2>&1 \
      || dbus-send --session --print-reply --dest=org.kde.KWin "/$id" org.kde.kwin.Script.run >/dev/null 2>&1
  fi
  if [ $((round % 5)) -eq 1 ]; then
    ps -eo pid,etimes,comm,args --sort=-start_time | grep -v '\[' | head -n 25 | logger -t obryx-windows
  fi
  sleep 4
done
rm -f "$script"
log "diagnostic finished"
