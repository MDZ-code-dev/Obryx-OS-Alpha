#!/usr/bin/env bash
# TEMPORARY alpha diagnostic (remove once the stray black window is fixed).
# KWin manages no window where the black box appears, so check what Plasma
# draws on the desktop and whether a compositor effect paints the box:
# screenshot with each third-party effect switched off and count black pixels.
log() { logger -t obryx-windows "$*"; }
log "diagnostic started"
for f in "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" "$HOME/.config/plasmashellrc"; do
  [ -f "$f" ] && grep -E '^\[|plugin=|wallpaperplugin=|Image=' "$f" | head -n 60 | logger -t obryx-windows
done
measure() {
  shot=$(mktemp --suffix=.png)
  if ! spectacle --background --nonotify --fullscreen --output "$shot" >/dev/null 2>&1 || [ ! -s "$shot" ]; then
    log "$1: screenshot failed"; rm -f "$shot"; return
  fi
  result=$(python3 - "$shot" <<'PY'
import sys
import gi
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf
pix = GdkPixbuf.Pixbuf.new_from_file(sys.argv[1])
w, h, n, stride = pix.get_width(), pix.get_height(), pix.get_n_channels(), pix.get_rowstride()
data = pix.get_pixels()
black = 0
for y in range(0, int(h * 0.8), 2):
    row = y * stride
    for x in range(0, w, 2):
        i = row + x * n
        if data[i] <= 3 and data[i + 1] <= 3 and data[i + 2] <= 3:
            black += 4
print(f"{w}x{h} black_pixels={black}")
PY
)
  log "$1: ${result}"
  rm -f "$shot"
}
effect() {
  dbus-send --session --print-reply --dest=org.kde.KWin /Effects "org.kde.kwin.Effects.$1" "string:$2" >/dev/null 2>&1
}
log "loaded effects: $(dbus-send --session --print-reply --dest=org.kde.KWin /Effects org.freedesktop.DBus.Properties.Get string:org.kde.kwin.Effects string:loadedEffects 2>&1 | tr -s ' \n' ' ')"
sleep 2
measure "both effects on"
effect unloadEffect glass; sleep 2
measure "glass off"
effect loadEffect glass; effect unloadEffect kwin4_effect_shapecorners; sleep 2
measure "rounded corners off"
effect unloadEffect glass; sleep 2
measure "both off"
effect loadEffect glass; effect loadEffect kwin4_effect_shapecorners
log "diagnostic finished, effects restored"
