[General]
count=3
rules=onyx-shell,obryx-window-opacity,obryx-home-center

[onyx-shell]
Description=Obryx Home and Settings
wmclass=org.onyx.Desktop.(Home|Settings|Apps|Cyber|Developer)
wmclassmatch=3
noborder=true
noborderrule=2

[obryx-window-opacity]
Description=Obryx readable windows
wmclassmatch=0
types=33
opacityactive=98
opacityactiverule=2
opacityinactive=98
opacityinactiverule=2

# Home always opens in the same place, in the centre of the screen.
[obryx-home-center]
Description=Obryx Home opens in the centre
wmclass=org.onyx.Desktop.Home
wmclassmatch=1
placement=5
placementrule=2
